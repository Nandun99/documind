# Copy to .env and fill in your key
OPENAI_API_KEY=sk-...

# openai | local (local runs fully offline with simple embeddings and an extractive answer model)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# MIN_RELEVANCE=0.2

# Cost estimate (USD per 1M tokens) for the chat model
INPUT_COST_PER_1M=0.15
OUTPUT_COST_PER_1M=0.60

DATA_DIR=data
